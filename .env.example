# Use only personal accounts. Do not copy another project's .env or send credentials in chat.
# Omit MODEL_PROVIDER in old installations to retain DeepSeek. Codex uses saved ChatGPT login.
MODEL_PROVIDER=codex-cli
CODEX_CLI_PATH=
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=high
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PLANNER_MODEL=deepseek-flash
DEEPSEEK_WRITER_MODEL=deepseek-flash
DEEPSEEK_TRANSLATION_MODEL=deepseek-flash
DEEPSEEK_REVIEW_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=32768
EXA_API_KEY=
DATALAB_API_KEY=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Workspace ID: T...; your user ID: U...; #general channel ID: C...
SLACK_TEAM_ID=
SLACK_USER_ID=
SLACK_CHANNEL_ID=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional byline; leave blank to omit it.
WECHAT_AUTHOR=

# Keep true before first integration testing. Dry-run still uses model, search, and parsing services but does not write to WeChat.
HUB_DRY_RUN=true
SLACK_EDIT_DEBOUNCE_MS=5000
MAX_QUEUE_SIZE=100
TASK_TIMEOUT_MS=1800000
BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Defaults to ./runtime; do not point it at another project's directory.
DATA_DIR=./runtime

# Optional daily LLM + quantitative-finance research. Fixed UTC-8 17:00 starts research.
# On first enable, the first scheduled issue is the next 17:00; later restarts catch up only the latest issue.
DAILY_ENABLED=false
# Optional ISO instant of activation, including timezone. Leave blank for a persisted first-enable timestamp.
DAILY_ENABLED_AT=
DAILY_TASK_TIMEOUT_MS=3600000
DAILY_MAX_CANDIDATES=80
DAILY_MAX_DEEP_READS=12
DAILY_MAX_QUERIES=12

# Confirm only when the account has free credits and paid use/recharge is disabled.
# Daily data retrieval never silently enables a paid provider. DeepSeek inference is billed separately.
DAILY_EXA_FREE_CONFIRMED=false
DAILY_EXA_MONTHLY_CENTS=900
TAVILY_API_KEY=
DAILY_TAVILY_FREE_CONFIRMED=false
DAILY_TAVILY_MONTHLY_CREDITS=900
FIRECRAWL_API_KEY=
DAILY_FIRECRAWL_FREE_CONFIRMED=false
# Keep below the verified free monthly grant; a paid balance never authorizes daily use.
DAILY_FIRECRAWL_MONTHLY_CREDITS=900
OPENALEX_API_KEY=
DAILY_OPENALEX_DAILY_CENTS=90
GITHUB_TOKEN=
# Unauthenticated default is 60; with GITHUB_TOKEN the default is 4000.
DAILY_GITHUB_HOURLY_REQUESTS=
