# 只填写个人账号。不要复制其他项目 .env，不要将密钥发送到聊天。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PLANNER_MODEL=deepseek-flash
DEEPSEEK_WRITER_MODEL=deepseek-flash
DEEPSEEK_TRANSLATION_MODEL=deepseek-flash
DEEPSEEK_REVIEW_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=32768
EXA_API_KEY=
DATALAB_API_KEY=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 工作区 ID: T...；本人 ID: U...；#general 频道 ID: C...
SLACK_TEAM_ID=
SLACK_USER_ID=
SLACK_CHANNEL_ID=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 可选署名，留空则不署名
WECHAT_AUTHOR=

# 首次联调前保持 true。模拟模式仍会使用模型、搜索与解析服务，但不会写入微信。
HUB_DRY_RUN=true
SLACK_EDIT_DEBOUNCE_MS=5000
MAX_QUEUE_SIZE=100
TASK_TIMEOUT_MS=1800000
BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 默认 ./runtime；不要指向其他项目目录
DATA_DIR=./runtime
